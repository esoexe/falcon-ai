{
  "name": "falcon-ai-desktop",
  "productName": "Falcon AI",
  "version": "4.0.1",
  "description": "Falcon AI v4.0 — Open-Source C++20 Neural 3D Bridge + CGTrader-Trained Catmull-Clark 3D Studio & Game Engine",
  "author": "Falcon AI Open Source",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "start:setup": "electron . --setup",
    "build:win": "electron-builder --win portable --x64",
    "build:linux": "electron-builder --linux AppImage --x64"
  },
  "build": {
    "appId": "ai.falcon.studio",
    "productName": "Falcon AI",
    "compression": "maximum",
    "directories": {
      "output": "../releases",
      "buildResources": "assets"
    },
    "files": [
      "electron/**/*",
      "installer/**/*",
      "assets/**/*",
      "web_bundle/**/*",
      "starter_assets/**/*"
    ],
    "win": {
      "icon": "assets/icon.png",
      "signAndEditExecutable": false,
      "extraResources": [
        {
          "from": "../bin",
          "to": "bin",
          "filter": [
            "falcon_server.exe",
            "falcon_dcc_bridge.exe",
            "falcon_corpus_trainer.exe"
          ]
        },
        {
          "from": "../data",
          "to": "data",
          "filter": [
            "*.json"
          ]
        }
      ],
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Falcon-AI-Setup-${version}-x64.exe"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Graphics",
      "extraResources": [
        {
          "from": "../bin",
          "to": "bin",
          "filter": [
            "falcon_server"
          ]
        }
      ],
      "target": [
        "AppImage"
      ]
    }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
