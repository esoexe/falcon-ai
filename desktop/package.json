{
  "name": "falcon-ai-desktop",
  "productName": "Falcon AI",
  "version": "3.0.0",
  "description": "Falcon AI v3.0 — Open-Source C++20 3D Studio (Quad Remesh, 4K PBR, Multi-View, 24-Clip Rig, FBX/USDZ, 3D Games & Engine Plugins)",
  "author": "Falcon AI Open Source",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "start:setup": "electron . --setup",
    "build:win": "electron-builder --win portable --x64",
    "build:linux": "electron-builder --linux AppImage --x64"
  },
  "build": {
    "appId": "ai.falcon.studio",
    "productName": "Falcon AI",
    "compression": "maximum",
    "directories": {
      "output": "../releases",
      "buildResources": "assets"
    },
    "files": [
      "electron/**/*",
      "installer/**/*",
      "assets/**/*",
      "web_bundle/**/*",
      "starter_assets/**/*"
    ],
    "win": {
      "icon": "assets/icon.png",
      "signAndEditExecutable": false,
      "extraResources": [
        {
          "from": "../bin",
          "to": "bin",
          "filter": ["falcon_server.exe", "falcon_dcc_bridge.exe"]
        }
      ],
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "Falcon-AI-Setup-${version}-x64.exe"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Graphics",
      "extraResources": [
        {
          "from": "../bin",
          "to": "bin",
          "filter": ["falcon_server"]
        }
      ],
      "target": ["AppImage"]
    }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
